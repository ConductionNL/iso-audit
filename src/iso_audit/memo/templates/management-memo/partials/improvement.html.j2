{#- Eén verbeterpunt (variabele `imp`). Zelfde compacte vorm als een NC-blok: het advies
    hoort in de memo, de onderbouwing in de bijlage. -#}
<h2>{{ imp.code }}{% if imp.code %} — {% endif %}{{ imp.title }}</h2>

<p class="norm-ref">
{%- for c in imp.citations %}{% if not loop.first %} · {% endif %}{{ c.standard }} §{{ c.clause }} — {{ c.title }}{% endfor -%}
</p>

{% if imp.kern %}
<p class="kern"><strong>{{ imp.kern }}</strong></p>
{% endif %}

{% if imp.deviation %}
<div>{{ imp.deviation | safe }}</div>
{% endif %}

{# Eén regel, geen kop: waarom dit een verbeterpunt is en geen NC. Zonder die verantwoording
   is de klasse een bewering, en "alles moet duidelijk zijn" gaat juist hierover. #}
<p class="rationale"><em>Waarom verbeterpunt en geen NC?</em> {{ imp.classification_rationale | safe }}</p>

{% if imp.suggestion %}
<div class="recommendation"><strong>Aanbeveling:</strong> {{ imp.suggestion | safe }}</div>
{% endif %}

{% include "management-memo/partials/bijlage-verwijzing.html.j2" %}
