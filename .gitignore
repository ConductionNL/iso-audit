# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Project-specifiek: lokale audit-data en runtime artefacten
output/
*.db
*.db-journal
.env
.env.local
.env.*.local

# Secrets / credentials — never commit
*.pem
*.key
*_rsa
*.crt
*.p12
*.pfx

# Run-artefacten van externe agent-harnassen (habitat). Deze horen niet in de
# historie van een repo die onder ISO 27001-scope valt: het zijn build-outputs,
# geen bewijs. Zie CHANGELOG 2026-08-14.
.habitat/

# Een GLOBALE gitignore-regel (een kale `config` in ~/.gitignore_global) sluit ELKE map
# met de naam `config` uit — ook Python-packages. Dat kostte op 2026-08-14 een rode CI:
# `src/iso_audit/config/` en `tests/config/` werden stil niet gecommit, terwijl de
# working tree lokaal groen was. Deze negaties halen ze expliciet terug.
#
# De map moet vóór de bestanden terug: git daalt niet af in een uitgesloten map. En
# alleen `*.py`, niet `**` — dat laatste overrulet de __pycache__-regel en trekt
# bytecode mee de commit in.
!src/iso_audit/config/
!src/iso_audit/config/*.py
!tests/config/
!tests/config/*.py
